  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@better-auth/cli": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
