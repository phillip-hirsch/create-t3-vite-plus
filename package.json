{
  "name": "create-t3-turbo",
  "private": true,
  "engines": {
    "node": "^22.21.0",
    "pnpm": "^10.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "vp run -r build",
    "clean": "vp run -r clean && git clean -xdf node_modules",
    "auth:generate": "vp run --filter @acme/auth generate",
    "db:push": "vp run --filter @acme/db push",
    "db:studio": "vp run --filter @acme/db studio",
    "dev": "vp run --filter @acme/tanstack-start dev",
    "dev:expo": "vp run --filter @acme/expo dev",
    "format": "vp run -r format --cache --cache-location .cache/.prettiercache",
    "format:fix": "vp run -r format --write --cache --cache-location .cache/.prettiercache",
    "lint": "vp run -r lint --cache --cache-location .cache/.eslintcache",
    "lint:fix": "vp run -r lint --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "typecheck": "vp run -r typecheck",
    "ui-add": "vp run --filter @acme/ui ui-add",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:*",
    "@turbo/gen": "^2.5.8",
    "@types/node": "catalog:",
    "dotenv-cli": "^10.0.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
