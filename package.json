{
  "name": "create-t3-vite-plus",
  "private": true,
  "engines": {
    "node": "^22.21.0",
    "pnpm": "^12.10.1"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "vp run -r build",
    "clean": "vp run -r clean && git clean -xdf node_modules",
    "auth:generate": "vp run --filter @acme/auth generate",
    "db:generate": "vp run --filter @acme/db generate",
    "db:migrate": "vp run --filter @acme/tanstack-start db:migrate",
    "db:migrate:remote": "vp run --filter @acme/tanstack-start db:migrate:remote",
    "deploy": "vp run --filter @acme/tanstack-start deploy",
    "dev": "vp run --filter @acme/tanstack-start dev",
    "dev:expo": "vp run --filter @acme/expo dev",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint:ws": "vp dlx sherif@latest",
    "prepare": "vp config --no-agent",
    "postinstall": "vp run lint:ws",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck",
    "verify": "vp install --frozen-lockfile && vp run lint && vp run lint:ws && vp run format && vp run typecheck",
    "ui-add": "vp run --filter @acme/ui ui-add",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dotenv-cli": "^10.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
