# Copy this file to `.env` and fill in the values. Git ignores `.env`.
# This file is committed, so don't put real secrets in it.
#
# `vp run dev` loads `.env` for local development. The deployed web app doesn't
# read it. Its values are Worker secrets, see "Deployment" in the README.
#
# Keep this file up to date when you add a variable. A new variable also needs
# a `bindings.secret()` entry in `apps/tanstack-start/cloudflare.config.ts`.

# Generate one with `openssl rand -base64 32`.
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET='supersecret'

# Client ID and secret of your Discord OAuth application.
# @see https://www.better-auth.com/docs/authentication/discord
AUTH_DISCORD_ID=''
AUTH_DISCORD_SECRET=''

# The Web app origin, which is the public origin of the deployed web app.
# Optional in development, required in production. Set it here to send
# Discord sign-in from local development and the mobile app through the
# deployed web app.
# WEB_APP_ORIGIN="https://acme-tanstack-start.<your-subdomain>.workers.dev"
